{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/contracts/common.schema.json",
  "title": "Common definitions (contracts v1)",
  "description": "Shared types. Every other contract references these $defs. Changing anything here is a contract change (see docs/contracts/README.md).",
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash16": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "pattern": "^case-[a-z0-9]+(-[a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9-]+__case-[a-z0-9-]+__B[012]__s\\d+$" },
    "docId": { "type": "string", "pattern": "^doc-[a-f0-9]{16}$" },
    "evidenceId": { "type": "string", "pattern": "^ev-[a-f0-9]{16}$" },
    "queryId": { "type": "string", "pattern": "^q\\d{3}$" },
    "resultId": { "type": "string", "pattern": "^r\\d{3}-\\d{2}$" },
    "linkId": { "type": "string", "pattern": "^l\\d{3}-\\d{2}$" },
    "gapId": { "type": "string", "pattern": "^g-[a-f0-9]{8}$" },
    "stableId": {
      "description": "Stable identifier of a target entity. Scheme 'opp' = grant opportunity (v1); 'inv' and 'usr' reserved for investors and users. Registry part is lower-case; the value keeps the official casing (see docs/contracts/README.md §Identifiers).",
      "type": "string",
      "pattern": "^(opp|inv|usr):(nih|nsf|grantsgov|eu|sbir|ukri|url):[^\\s]+$"
    },
    "criterionId": { "type": "string", "pattern": "^((G|P)-[A-Z]+|REQ-\\d{2})$" },
    "criterionState": { "type": "string", "enum": ["met", "not_met", "unknown", "not_applicable", "conflict"] },
    "condition": { "type": "string", "enum": ["B0", "B1", "B2"] },
    "targetType": { "type": "string", "enum": ["grant", "investor", "user"] },
    "route": { "type": "string", "enum": ["direct_apply", "partner_subaward", "procurement_vendor", "future_cycle", "not_actionable"] },
    "validityStatus": { "type": "string", "enum": ["open", "upcoming", "rolling", "closed", "not_a_call", "awarded", "unknown"] },
    "pageType": { "type": "string", "enum": ["call", "program_page", "funder_about", "award_record", "news", "blog", "report", "event", "directory", "other"] },
    "instrument": { "type": "string", "enum": ["grant", "prize", "contract", "cooperative_agreement", "loan", "equity", "in_kind", "unknown"] },
    "officialBasis": { "type": "string", "enum": ["suffix", "curated_list", "issuer_match", "none"] },
    "errorCode": {
      "type": "string",
      "enum": ["SEARCH_HTTP", "SEARCH_TIMEOUT", "FETCH_HTTP", "FETCH_TIMEOUT", "FETCH_BLOCKED", "FETCH_EMPTY", "LLM_HTTP", "LLM_TIMEOUT", "LLM_BAD_JSON", "LLM_SCHEMA", "QUOTE_NOT_LITERAL", "ID_NOT_LITERAL", "BUDGET", "CONTRACT", "PLANNER_INVALID_ACTION", "INTERNAL"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "maxLength": 300 },
        "ref": { "type": "string", "description": "doc_id, query_id, result_id or criterion id the error refers to" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "completion", "total", "nominal_total", "estimated", "cached"],
      "properties": {
        "prompt": { "type": "integer", "minimum": 0 },
        "completion": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0, "description": "Tokens actually spent now (0 on a cache hit)." },
        "nominal_total": { "type": "integer", "minimum": 0, "description": "Tokens the call cost when first made (equal to total on a miss). Budgets use this." },
        "estimated": { "type": "boolean", "description": "true when the API returned no usage and tokens = ceil(chars/4)." },
        "cached": { "type": "boolean" }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_ms", "nominal_ms"],
      "properties": {
        "actual_ms": { "type": "integer", "minimum": 0 },
        "nominal_ms": { "type": "integer", "minimum": 0, "description": "Latency when first made (cache stores it). Time budget uses this." }
      }
    },
    "promptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "enum": ["planner", "extractor", "eligibility_judge", "preannotator", "b0_templates"] },
        "version": { "type": "string", "pattern": "^v\\d+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_family", "prompts", "code_sha", "contracts_version", "catalog_version", "official_domains_version"],
      "properties": {
        "model_id": { "$ref": "#/$defs/nonEmpty", "description": "Model id as returned by the API (choices[].model), not the configured alias." },
        "model_family": { "$ref": "#/$defs/nonEmpty" },
        "prompts": { "type": "array", "items": { "$ref": "#/$defs/promptRef" }, "minItems": 1 },
        "code_sha": { "type": "string", "pattern": "^[a-f0-9]{7,40}(-dirty)?$" },
        "contracts_version": { "const": "1" },
        "catalog_version": { "type": "string", "pattern": "^criteria_catalog\\.grant@v\\d+$" },
        "official_domains_version": { "type": "string", "pattern": "^official_domains@v\\d+$" }
      }
    },
    "fieldValue": {
      "description": "A profile value with provenance. value=null means UNKNOWN (never a default).",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "as_of"],
      "properties": {
        "value": {},
        "source": { "type": "string", "minLength": 1, "description": "Where the value comes from (document title, URL, 'intake answer 2026-10-05', 'not provided')." },
        "as_of": { "$ref": "#/$defs/isoDate" },
        "quote": { "type": ["string", "null"], "description": "Verbatim supporting text when the source is a document." }
      }
    }
  }
}
