{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/contracts/criteria_catalog.schema.json",
  "title": "Criteria catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "target_type", "criteria"],
  "properties": {
    "schema_version": { "const": "criteria_catalog/1" },
    "catalog_id": { "type": "string", "pattern": "^criteria_catalog\\.(grant|investor|user)$" },
    "version": { "type": "string", "pattern": "^v\\d+$" },
    "target_type": { "$ref": "common.schema.json#/$defs/targetType" },
    "status": { "type": "string", "enum": ["proposed", "approved"], "description": "Human step H3 approves the catalog before the first benchmark run." },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "allOf": [{ "$ref": "criterion.schema.json" }, { "properties": { "origin": { "const": "catalog" } } }] }
    }
  }
}
