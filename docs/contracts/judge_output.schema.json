{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/contracts/judge_output.schema.json",
  "title": "eligibility_judge raw output (from the LLM) — UNTRUSTED until rules R1–R7 run",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "route", "route_rationale"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "state", "evidence_ids", "rationale"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^((G|P)-[A-Z]+|REQ-\\d{2})$" },
          "state": { "type": "string", "enum": ["met", "not_met", "unknown", "not_applicable", "conflict"] },
          "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^ev-[a-f0-9]{16}$" }, "maxItems": 6 },
          "rationale": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "route": { "type": "string", "enum": ["direct_apply", "partner_subaward", "procurement_vendor", "future_cycle", "not_actionable"] },
    "route_rationale": { "type": "string", "maxLength": 300 }
  }
}
