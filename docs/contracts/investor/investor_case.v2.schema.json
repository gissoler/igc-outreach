{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/contracts/investor/investor_case.v2.schema.json",
  "title": "Investor benchmark case v2 (adds kind=debug)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "kind",
    "as_of",
    "profile_path",
    "profile_sha256",
    "construction",
    "anchors",
    "null_case"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "investor_case/1",
        "investor_case/2"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^inv-case-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "anchor",
        "null",
        "debug"
      ]
    },
    "as_of": {
      "$ref": "../common.schema.json#/$defs/isoDate"
    },
    "profile_path": {
      "type": "string",
      "pattern": "^research/(bench/investors/cases(?:-debug)?/profiles|tests/agent/fixtures/investor-world-v0)/.+\\.json$"
    },
    "profile_sha256": {
      "$ref": "../common.schema.json#/$defs/sha256"
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curator",
        "profile_builder",
        "profile_builder_saw_investors",
        "selection_order",
        "profile_frozen_at",
        "curation_started_at"
      ],
      "properties": {
        "curator": {
          "type": "string",
          "minLength": 1
        },
        "profile_builder": {
          "type": "string",
          "minLength": 1
        },
        "profile_builder_saw_investors": {
          "const": false
        },
        "selection_order": {
          "const": "profile_first"
        },
        "profile_frozen_at": {
          "$ref": "../common.schema.json#/$defs/isoDateTime"
        },
        "curation_started_at": {
          "$ref": "../common.schema.json#/$defs/isoDateTime"
        }
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stable_id",
          "canonical_name",
          "official_url",
          "active_status",
          "verified_on",
          "compatibility_evidence",
          "found_after_profile_freeze",
          "selected_from_system_results"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^inv:(domain|regulatory|url):[^\\s]+$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 2
          },
          "official_url": {
            "$ref": "../common.schema.json#/$defs/url"
          },
          "active_status": {
            "type": "string",
            "enum": [
              "active",
              "possibly_active"
            ]
          },
          "verified_on": {
            "$ref": "../common.schema.json#/$defs/isoDate"
          },
          "compatibility_evidence": {
            "type": "string",
            "minLength": 20
          },
          "found_after_profile_freeze": {
            "const": true
          },
          "selected_from_system_results": {
            "const": false
          },
          "historical_investment_control": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "null_case": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "manual_search_minutes",
            "manual_queries",
            "conclusion"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 20
            },
            "manual_search_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "manual_queries": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string"
              }
            },
            "conclusion": {
              "const": "no_active_investor_with_gain_gte_2_found_within_scope"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "anchor"
          }
        }
      },
      "then": {
        "properties": {
          "anchors": {
            "minItems": 1
          },
          "null_case": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "null"
          }
        }
      },
      "then": {
        "properties": {
          "anchors": {
            "maxItems": 0
          },
          "null_case": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "debug"
          }
        }
      },
      "then": {
        "properties": {
          "anchors": {
            "maxItems": 0
          },
          "null_case": {
            "type": "null"
          }
        }
      }
    }
  ]
}
