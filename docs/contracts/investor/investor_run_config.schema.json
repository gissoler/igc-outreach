{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/contracts/investor/investor_run_config.schema.json",
  "title": "Investor benchmark run configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bench_id", "status", "today", "search", "agent_model", "preannotator_model", "budgets", "patience_n", "default_fetch_per_search", "b2", "seeds", "prompts", "catalog", "decision_rule"],
  "properties": {
    "schema_version": { "const": "investor_run_config/1" },
    "bench_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["draft", "frozen"] },
    "today": { "$ref": "../common.schema.json#/$defs/isoDate" },
    "search": { "type": "object", "additionalProperties": false, "required": ["provider", "results_per_query"], "properties": { "provider": { "type": "string", "enum": ["searxng", "fixture", "failover"] }, "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["exa", "serper", "tavily"] } }, "fallback_policy": { "type": "string", "enum": ["first_nonempty"] }, "results_per_query": { "type": "integer", "minimum": 5, "maximum": 20 } }, "allOf": [{ "if": { "properties": { "provider": { "const": "failover" } }, "required": ["provider"] }, "then": { "required": ["providers", "fallback_policy"] } }] },
    "agent_model": { "$ref": "#/$defs/model" },
    "preannotator_model": { "$ref": "#/$defs/model" },
    "budgets": { "type": "object", "additionalProperties": false, "required": ["searches", "fetches", "planner_calls", "tokens_nominal", "seconds_nominal"], "properties": { "searches": { "type": "integer", "minimum": 1 }, "fetches": { "type": "integer", "minimum": 1 }, "planner_calls": { "type": "integer", "minimum": 1 }, "tokens_nominal": { "type": "integer", "minimum": 1000 }, "seconds_nominal": { "type": "integer", "minimum": 1 } } },
    "patience_n": { "type": "integer", "minimum": 1 },
    "default_fetch_per_search": { "type": "integer", "minimum": 1, "maximum": 10 },
    "b2": { "type": "object", "additionalProperties": false, "required": ["initial_batch", "max_searches_per_step"], "properties": { "initial_batch": { "type": "integer", "minimum": 1 }, "max_searches_per_step": { "type": "integer", "minimum": 1 } } },
    "seeds": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "integer" } },
    "prompts": { "type": "object", "additionalProperties": false, "required": ["b0_templates", "planner", "extractor", "judge", "preannotator"], "properties": { "b0_templates": { "const": "v1" }, "planner": { "const": "v1" }, "extractor": { "const": "v1" }, "judge": { "const": "v1" }, "preannotator": { "const": "v1" } } },
    "catalog": { "const": "criteria_catalog.investor@v1" },
    "decision_rule": { "type": "object", "additionalProperties": false, "required": ["status", "min_recall_gain", "alpha", "max_ndcg_drop", "max_hard_false_positive_rate", "min_correct_null_abstentions"], "properties": { "status": { "const": "proposed" }, "min_recall_gain": { "type": "number", "minimum": 0 }, "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "max_ndcg_drop": { "type": "number", "minimum": 0 }, "max_hard_false_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "min_correct_null_abstentions": { "type": "integer", "minimum": 0 } } }
  },
  "$defs": { "model": { "type": "object", "additionalProperties": false, "required": ["family", "model_id"], "properties": { "family": { "type": "string", "minLength": 2 }, "model_id": { "type": "string", "minLength": 1 } } } }
}
