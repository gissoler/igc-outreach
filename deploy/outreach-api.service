[Unit]
Description=IGC Outreach - API warmpath (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=outreach
Group=outreach
WorkingDirectory=/opt/outreach/backend
Environment=WARMPATH_HOST=127.0.0.1
Environment=PORT=8000
Environment=WARMPATH_CORS=https://DOMINIO
# Claves opcionales (ANTHROPIC_API_KEY, SEC_USER_AGENT…) en backend/.env
EnvironmentFile=-/opt/outreach/backend/.env
ExecStart=/opt/outreach/.venv/bin/warmpath-api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/outreach/backend

[Install]
WantedBy=multi-user.target
