    "product": {
      "value": "Working-capital credit and invoice-payment service that lets small independent restaurants buy from their food suppliers now and pay later",
      "source": "synthetic",
      "as_of": "2026-10-08",
      "quote": null
    },
    "description": {
      "value": "Independent restaurants struggle with the cash gap between receiving supplies and paying for them, while their food distributors want to be paid immediately. Tandoval Pay closes that gap: the restaurant pays the distributor 30 days later and the distributor is paid upfront. It reads CFDI electronic-invoice records to digitise each invoice and sets short-term credit limits from the restaurant's purchase history. It earns money from fees charged to distributors and from the interest spread on the credit.",
      "source": "synthetic",
      "as_of": "2026-10-08",
      "quote": null
    },
