# Todo es opcional. No copies claves al frontend.
RESEARCH_PORT=8788
RESEARCH_DB=data/research.sqlite
RESEARCH_TIMEOUT_MS=12000
RESEARCH_USER_AGENT=IGCOutreachResearch/1.0
# Mejora cuotas de OpenAlex; sin clave se intenta acceso público.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Búsqueda complementaria. Snippets siempre son pistas no verificadas.
SERPER_API_KEY=
# Exa: búsqueda semántica (una consulta por objetivo con el perfil completo) y anuncios de
# rondas (categoría news). Con Exa, los anuncios de rondas funcionan aunque no haya Serper.
EXA_API_KEY=
EXA_NUM_RESULTS=8

# Enriquecimiento opcional de personas públicas. Usa un token con el menor
# alcance posible y un Actor sin cookies. El token viaja en Authorization,
# nunca en la URL ni al frontend. Cada ejecución puede consumir crédito.
APIFY_TOKEN=
APIFY_ACTOR_ID=harvestapi/linkedin-company-employees
APIFY_COMPANY_SEARCH_ACTOR_ID=harvestapi/linkedin-company-search
APIFY_DISCOVERY_MAX_COMPANIES=5
APIFY_PROFILE_SEARCH_ACTOR_ID=harvestapi/linkedin-profile-search
APIFY_DISCOVERY_MAX_PEOPLE=10
APIFY_PROFILE_ACTOR_ID=harvestapi/linkedin-profile-scraper
# Red de interacciones públicas: posts del usuario, comentaristas/reactores y actividad
# creada por el usuario en posts de otras personas. No usa cookies ni exports.
APIFY_INTERACTIONS_ACTOR_ID=harvestapi/linkedin-profile-posts
APIFY_PROFILE_COMMENTS_ACTOR_ID=harvestapi/linkedin-profile-comments
APIFY_PROFILE_REACTIONS_ACTOR_ID=harvestapi/linkedin-profile-reactions
APIFY_INTERACTION_MAX_POSTS=10
APIFY_INTERACTION_MAX_COMMENTS=50
APIFY_INTERACTION_MAX_REACTIONS=100
APIFY_INTERACTION_MAX_ITEMS=750
APIFY_INTERACTION_MONTHS=12
# Grafo autenticado: la sesión se usa solo durante la petición y nunca se persiste.
APIFY_NETWORK_SEARCH_ACTOR_ID=crawlerbros/linkedin-people-search-scraper
APIFY_MUTUALS_ACTOR_ID=data_link_miner/linkedin-shared-connections
APIFY_NETWORK_MAX_PEOPLE=40
APIFY_NETWORK_MAX_MUTUAL_TARGETS=5
APIFY_NETWORK_MAX_MUTUALS=15
APIFY_MAX_ITEMS=20
APIFY_MAX_COMPANIES=5
APIFY_TIMEOUT_MS=120000
# Opcional: organizaciones semilla y cargos, separados por coma.
APIFY_TARGET_COMPANIES=
APIFY_JOB_TITLES=Business Development,Corporate Development,Search and Evaluation,Licensing,Alliance Management,Partner,Investment Director

# Capa opcional de decisión estructurada. Jev no descubre datos ni sustituye las
# exclusiones deterministas: enruta candidatos a priorizar o investigar/revisar.
# Crea la clave en https://jevmodel.net/settings/apikeys y mantenla solo en el servidor.
JEV_API_KEY=
JEV_API_URL=https://jevmodel.net/v1/systemone
JEV_MODEL=jev-latest
JEV_MAX_CANDIDATES=15
JEV_TIMEOUT_MS=20000

# OAuth de Gmail, Outlook, Calendar, HubSpot y Apollo no está implementado en
# este MVP local. Las fuentes se conectan mediante exports CSV/ICS reales.
# No agregues credenciales hasta implementar callbacks y cifrado de tokens.

# Agente de prerregistro. Endpoint compatible con OpenAI: Ollama, LM Studio, vLLM…
# El modelo es quien interpreta la conversación y los documentos (no reglas de patrones) cuando
# está configurado; las reglas de patrones son solo la red de seguridad si no hay modelo o si la
# llamada falla en ese turno. Sin INTAKE_LLM_BASE_URL, el agente usa siempre esa red de seguridad.
#
# Flota propia en 147.185.41.229 — un modelo por puerto:
#   8000 qwen-30b     (más calidad, turnos más lentos)
#   8001 qwen-4b       (recomendado por defecto: rápido, suficiente para extraer un perfil)
#   8002 deepseek-8b
#   8003 baai          (embeddings — NO sirve aquí, no responde /chat/completions)
#   8004 mixbread      (reranking — NO sirve aquí, no responde /chat/completions)
# Verifica el "model" exacto antes de arrancar: curl http://147.185.41.229:<puerto>/v1/models
#
# Alternativa local: Ollama (`ollama pull qwen3:4b`) con INTAKE_LLM_BASE_URL=http://127.0.0.1:11434/v1
INTAKE_LLM_BASE_URL=
INTAKE_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
INTAKE_LLM_API_KEY=
# Qwen3 razona por defecto; false añade /no_think (más rápido). Pendiente de evaluar.
INTAKE_LLM_THINK=false
INTAKE_LLM_TIMEOUT_MS=90000
INTAKE_LLM_DOC_CHARS=12000

# Firecrawl + ScrapeGraph (reemplazan a Apify). Firecrawl busca y lee páginas públicas;
# ScrapeGraph extrae personas, cargos y afiliaciones. Sin las dos claves, la fuente se omite.
FIRECRAWL_API_KEY=
SGAI_API_KEY=
# Límites (opcionales): páginas y personas por evaluación, páginas para relaciones públicas.
WEB_MAX_PAGES=4
WEB_MAX_PEOPLE=20
WEB_RELATION_MAX_PAGES=6

# ───────── Capa de análisis (tesis revelada, momento, acercamientos, grants, voz del decisor) ─────────
# Flota vLLM propia. Confirma los ids reales con: node --env-file-if-exists=.env scripts/fleet-check.mjs
# Si solo pones VLLM_BASE, los puertos por defecto son 8000 chat, 8001 small, 8002 reasoning, 8003 embed, 8004 rerank.
VLLM_BASE=
VLLM_API_KEY=
VLLM_TIMEOUT_MS=120000
VLLM_CHAT_MODEL=
VLLM_SMALL_MODEL=
VLLM_REASONING_MODEL=
VLLM_EMBED_MODEL=
VLLM_RERANK_MODEL=
# URL por rol (opcional; sobrescriben VLLM_BASE:puerto). Formato: http://host:puerto/v1
VLLM_CHAT_URL=
VLLM_SMALL_URL=
VLLM_REASONING_URL=
VLLM_EMBED_URL=
VLLM_RERANK_URL=
# Quién extrae deals: chat (qwen-30b), small (qwen-4b) o el nombre de un adaptador LoRA servido en el puerto de small.
VLLM_EXTRACT_ROLE=chat
# Voz a texto para podcasts (Módulo 3). vLLM /v1/audio/transcriptions con un modelo tipo Whisper.
VLLM_ASR_URL=
VLLM_ASR_MODEL=
# Vehículos Form D (generado por: python -m warmpath.ingest.formd_vehicles … --out ../research/data/fund_vehicles.json)
FUND_VEHICLES_PATH=data/fund_vehicles.json
# Resultados de evaluación que muestra la pestaña Backtest y perfil de elegibilidad editable en la app.
EVAL_RESULTS_DIR=../backend/eval/results
ELIGIBILITY_PROFILE_PATH=data/eligibility_profile.json
# Línea base (b) del backtest: un LLM con el mismo perfil (scripts/baseline-llm.mjs). Solo en el servidor.
ANTHROPIC_API_KEY=
BASELINE_LLM_MODEL=
