# ── Nombres que ve el usuario (la interfaz oculta los proveedores; ver frontend/src/brand.ts) ──
#   Decision Agent = OpenJev/Jev · Semantic Search = Exa · Web Search = Serper (y SearXNG) · Deep Search = Linkup
#   News Search = You.com · Answer Search = Tavily · Page Reader = Jina · Web Reader = Firecrawl + ScrapeGraph
#   Contact Finder = Hunter · People Search = Apify (histórico) · AI model = vLLM/Qwen en la flota
# Todo es opcional. No copies claves al frontend.
RESEARCH_PORT=8788
RESEARCH_DB=data/research.sqlite
RESEARCH_TIMEOUT_MS=12000
RESEARCH_RUN_TIMEOUT_MS=180000
RESEARCH_MAX_RUNS_PER_DAY=3
RESEARCH_USER_AGENT=IGCOutreachResearch/1.0
# Mejora cuotas de OpenAlex; sin clave se intenta acceso público.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Búsqueda complementaria. Snippets siempre son pistas no verificadas.
SERPER_API_KEY=
# Exa: búsqueda semántica (una consulta por objetivo con el perfil completo) y anuncios de
# rondas (categoría news). Con Exa, los anuncios de rondas funcionan aunque no haya Serper.
EXA_API_KEY=
EXA_NUM_RESULTS=8

# Enriquecimiento opcional de personas públicas. Usa un token con el menor
# alcance posible y un Actor sin cookies. El token viaja en Authorization,
# nunca en la URL ni al frontend. Cada ejecución puede consumir crédito.
APIFY_TOKEN=
APIFY_ACTOR_ID=harvestapi/linkedin-company-employees
APIFY_COMPANY_SEARCH_ACTOR_ID=harvestapi/linkedin-company-search
APIFY_DISCOVERY_MAX_COMPANIES=5
APIFY_PROFILE_SEARCH_ACTOR_ID=harvestapi/linkedin-profile-search
APIFY_DISCOVERY_MAX_PEOPLE=10
APIFY_PROFILE_ACTOR_ID=harvestapi/linkedin-profile-scraper
# Red de interacciones públicas: posts del usuario, comentaristas/reactores y actividad
# creada por el usuario en posts de otras personas. No usa cookies ni exports.
APIFY_INTERACTIONS_ACTOR_ID=harvestapi/linkedin-profile-posts
APIFY_PROFILE_COMMENTS_ACTOR_ID=harvestapi/linkedin-profile-comments
APIFY_PROFILE_REACTIONS_ACTOR_ID=harvestapi/linkedin-profile-reactions
APIFY_INTERACTION_MAX_POSTS=10
APIFY_INTERACTION_MAX_COMMENTS=50
APIFY_INTERACTION_MAX_REACTIONS=100
APIFY_INTERACTION_MAX_ITEMS=750
APIFY_INTERACTION_MONTHS=12
# Grafo autenticado: la sesión se usa solo durante la petición y nunca se persiste.
APIFY_NETWORK_SEARCH_ACTOR_ID=crawlerbros/linkedin-people-search-scraper
APIFY_MUTUALS_ACTOR_ID=data_link_miner/linkedin-shared-connections
APIFY_NETWORK_MAX_PEOPLE=40
APIFY_NETWORK_MAX_MUTUAL_TARGETS=5
APIFY_NETWORK_MAX_MUTUALS=15
APIFY_MAX_ITEMS=20
APIFY_MAX_COMPANIES=5
APIFY_TIMEOUT_MS=120000
# Opcional: organizaciones semilla y cargos, separados por coma.
APIFY_TARGET_COMPANIES=
APIFY_JOB_TITLES=Business Development,Corporate Development,Search and Evaluation,Licensing,Alliance Management,Partner,Investment Director

# Capa de decisión estructurada (System One). No descubre datos ni sustituye las exclusiones
# deterministas: enruta candidatos y, en el orquestador, decide si hace falta otra búsqueda y con qué estrategia.
# OpenJev (open source, misma API que Jev) tiene prioridad. Endpoint hospedado por defecto; para un
# servidor propio: OPENJEV_API_URL=http://127.0.0.1:8080/v1/systemone (http solo en localhost, clave opcional).
OPENJEV_API_KEY=
OPENJEV_API_URL=
OPENJEV_MODEL=openjev
# JEV_PROVIDER=openjev|jev fuerza uno si tienes las dos claves.
JEV_PROVIDER=
# Jev de TypeSafe (alternativa de pago): https://jevmodel.net/settings/apikeys
JEV_API_KEY=
JEV_API_URL=https://jevmodel.net/v1/systemone
JEV_MODEL=jev-latest
JEV_MAX_CANDIDATES=15
JEV_TIMEOUT_MS=20000

# OAuth de Gmail, Outlook, Calendar, HubSpot y Apollo no está implementado.
# Apollo API sí puede usarse opcionalmente con una clave server-side y de solo
# lectura. Nunca se envía al frontend ni se crean contactos, campañas o mensajes.
# El preflight usa auth/health, estadísticas de uso, 1 página de organizaciones
# (puede consumir 1 crédito) y people search (0 créditos según la documentación
# consultada el 08/10/2026). Usa una clave con scopes mínimos.
APOLLO_ENABLED=0
APOLLO_API_KEY=
APOLLO_PREFLIGHT_DOMAIN=apollo.io
APOLLO_TIMEOUT_MS=15000
APOLLO_MAX_CREDITS_PER_RUN=8
APOLLO_MAX_CREDITS_PER_ORG=3
APOLLO_MAX_CREDITS_PER_DAY=30
APOLLO_MAX_ORGS_PER_RUN=3
APOLLO_PEOPLE_PER_ORG=5
APOLLO_CACHE_TTL_HOURS=24

# Estrategias de capital: fase previa al discovery. Apagada por defecto y fuera
# de B0/B1/B2. Sus rutas amplían consultas; nunca reescriben el perfil confirmado.
CAPITAL_STRATEGY_CONTEXT=0
CAPITAL_STRATEGY_MAX_ROUTES=6
CAPITAL_STRATEGY_MAX_QUERIES=18
CAPITAL_STRATEGY_MAX_CALLS=24
CAPITAL_STRATEGY_EXECUTE_MAX=6
CAPITAL_STRATEGY_MAX_MS=120000
CAPITAL_STRATEGY_MAX_COST_USD=1

# Agente de prerregistro. Endpoint compatible con OpenAI: Ollama, LM Studio, vLLM…
# El modelo es quien interpreta la conversación y los documentos (no reglas de patrones) cuando
# está configurado; las reglas de patrones son solo la red de seguridad si no hay modelo o si la
# llamada falla en ese turno. Sin INTAKE_LLM_BASE_URL, el agente usa siempre esa red de seguridad.
#
# Flota propia en 147.185.41.229 — un modelo por puerto:
#   8000 qwen-30b     (más calidad, turnos más lentos)
#   8001 qwen-4b       (recomendado por defecto: rápido, suficiente para extraer un perfil)
#   8002 deepseek-8b
#   8003 baai          (embeddings — NO sirve aquí, no responde /chat/completions)
#   8004 mixbread      (reranking — NO sirve aquí, no responde /chat/completions)
# Verifica el "model" exacto antes de arrancar: curl http://147.185.41.229:<puerto>/v1/models
#
# Alternativa local: Ollama (`ollama pull qwen3:4b`) con INTAKE_LLM_BASE_URL=http://127.0.0.1:11434/v1
INTAKE_LLM_BASE_URL=
INTAKE_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
INTAKE_LLM_API_KEY=
# Qwen3 razona por defecto; false añade /no_think (más rápido). Pendiente de evaluar.
INTAKE_LLM_THINK=false
INTAKE_LLM_TIMEOUT_MS=90000
INTAKE_LLM_DOC_CHARS=12000

# Firecrawl + ScrapeGraph (reemplazan a Apify). Firecrawl busca y lee páginas públicas;
# ScrapeGraph extrae personas, cargos y afiliaciones. Sin las dos claves, la fuente se omite.
FIRECRAWL_API_KEY=
SGAI_API_KEY=
# Límites (opcionales): páginas y personas por evaluación, páginas para relaciones públicas.
WEB_MAX_PAGES=4
WEB_MAX_PEOPLE=20
WEB_RELATION_MAX_PAGES=6

# Motor de investigación agentic. Todas las fases están apagadas hasta evaluarlas.
AGENTIC_FOLLOWUP=0
AGENTIC_READ=0
AGENTIC_LOOP=0
GRANT_WEB_MAX_SEARCHES=3
GRANT_WEB_RESULTS_PER_QUERY=6
LOOP_LLM_PLANNER=0
FOLLOWUP_MAX_ORGS=6
FOLLOWUP_MAX_PAGES=8
READ_MAX_DOCS=8
LOOP_MAX_ROUNDS=2
LOOP_MAX_SEARCHES=12
LOOP_RESULTS_PER_SEARCH=5
LOOP_BUDGET_MS=150000
LOOP_MAX_COST_USD=1.00
ACTIVE_WINDOW_MONTHS=18

# Estimación configurable de coste por llamada (USD). Los nombres corresponden al
# proveedor mostrado en job.usage; los no definidos se contabilizan con coste 0.
COST_EXA_PER_CALL=0
COST_SERPER_PER_CALL=0
COST_FIRECRAWL_PER_CALL=0
COST_SCRAPEGRAPH_PER_CALL=0

# ───────── Capa de análisis (tesis revelada, momento, acercamientos, grants, voz del decisor) ─────────
# Flota vLLM propia. Confirma los ids reales con: node --env-file-if-exists=.env scripts/fleet-check.mjs
# Si solo pones VLLM_BASE, los puertos por defecto son 8000 chat, 8001 small, 8002 reasoning, 8003 embed, 8004 rerank.
VLLM_BASE=
VLLM_API_KEY=
VLLM_TIMEOUT_MS=120000
VLLM_CHAT_MODEL=
VLLM_SMALL_MODEL=
VLLM_REASONING_MODEL=
VLLM_EMBED_MODEL=
VLLM_RERANK_MODEL=
# URL por rol (opcional; sobrescriben VLLM_BASE:puerto). Formato: http://host:puerto/v1
VLLM_CHAT_URL=
VLLM_SMALL_URL=
VLLM_REASONING_URL=
VLLM_EMBED_URL=
VLLM_RERANK_URL=
# Quién extrae deals: chat (qwen-30b), small (qwen-4b) o el nombre de un adaptador LoRA servido en el puerto de small.
VLLM_EXTRACT_ROLE=chat
# Voz a texto para podcasts (Módulo 3). vLLM /v1/audio/transcriptions con un modelo tipo Whisper.
VLLM_ASR_URL=
VLLM_ASR_MODEL=
# Vehículos Form D (generado por: python -m warmpath.ingest.formd_vehicles … --out ../research/data/fund_vehicles.json)
FUND_VEHICLES_PATH=data/fund_vehicles.json
# Resultados de evaluación que muestra la pestaña Backtest y perfil de elegibilidad editable en la app.
EVAL_RESULTS_DIR=../backend/eval/results
ELIGIBILITY_PROFILE_PATH=data/eligibility_profile.json
# Línea base (b) del backtest: un LLM con el mismo perfil (scripts/baseline-llm.mjs). Solo en el servidor.
ANTHROPIC_API_KEY=
BASELINE_LLM_MODEL=

# Motor v2 (lectura con el modelo de la flota + verificación en código). Requiere VLLM_CHAT_URL/VLLM_CHAT_MODEL (Qwen3-30B).
# 1 = cada resultado web de grants se lee, se comprueba su fecha contra la página y se calcula abierta/cerrada contra hoy.
GRANT_WEB_READ=
GRANT_WEB_READ_MAX=18
# Motor general (grants, inversores, deuda, partners): planea consultas, lee páginas y verifica en código. Sustituye al descubrimiento web de grants.
ENGINE_V2=
# Búsqueda propia (sin Firecrawl): metabuscador SearXNG autoalojado. Con esto el motor busca y descarga las páginas él mismo.
SEARXNG_URL=
SEARXNG_ENGINES=
ENGINE_ROUNDS=2

# ───────── Motor v2: APIs de búsqueda ─────────
# Todas opcionales; con al menos una, el motor v2 las usa en lugar de SearXNG/Firecrawl. Se consultan en paralelo
# y se unen por URL (una página que traen varios buscadores sube). Snippets = pistas; el motor lee y verifica.
# EXA_API_KEY (arriba) también se usa aquí.
LINKUP_API_KEY=
YOU_API_KEY=
TAVILY_API_KEY=
# Jina: buscador (s.jina.ai) y lector de páginas (r.jina.ai) para páginas con JavaScript o PDF que la descarga directa no lee.
JINA_API_KEY=
# Subconjunto a usar (por defecto todos los que tengan clave): linkup,exa,you,tavily,jina
ENGINE_SEARCH_PROVIDERS=
ENGINE_RESULTS_PER_PROVIDER=8
ENGINE_SEARCH_TIMEOUT_MS=45000
# Filtro de fecha de publicación para objetivos con plazo (day|week|month|year). Vacío = sin filtro (recomendado:
# muchas páginas oficiales son antiguas pero vigentes; el verificador descarta las cerradas).
ENGINE_RECENCY=
ENGINE_MAX_QUERIES=10
ENGINE_MAX_PAGES=40
# Crawl4AI: lector de páginas PROPIO (Docker en tu instancia, sin créditos por página). Lee con un navegador real, así que sirve para páginas con
# JavaScript. Orden de lectura: descarga directa → Crawl4AI → Jina → Firecrawl. Solo LEE: el modelo extrae y el código decide igual.
# Instalar en AWS: sudo bash /opt/outreach/deploy/crawl4ai.sh   (escucha solo en 127.0.0.1; deja CRAWL4AI_URL y FIRECRAWL_DISABLED=1 en el .env)
CRAWL4AI_URL=
# CRAWL4AI_TOKEN=            # solo si el servidor tiene JWT activado
# CRAWL4AI_TIMEOUT_MS=45000
# CRAWL4AI_MARKDOWN=raw      # raw = texto completo (conserva fechas y requisitos) · fit = filtrado
# Apaga Firecrawl entero (lector, segunda lectura JSON, búsqueda, contactos) aunque FIRECRAWL_API_KEY siga puesta. Sin segunda lectura JSON,
# el motor sigue releyendo con el mismo modelo la página completa (ENGINE_DATE_REREAD_MAX) y el código verifica igual.
# FIRECRAWL_DISABLED=1
# Segunda lectura de fechas y elegibilidad con Firecrawl (formato JSON con esquema). El extractor EXTRAE con cita literal y el código
# decide: si sus fechas no coinciden con la lectura de la página, la convocatoria baja a «a verificar». Se usa solo con FIRECRAWL_API_KEY,
# solo cuando puede cambiar la decisión (pasaría a la lista principal, conflicto de fechas o fecha sin resolver; «cerrada» solo si no hay
# otra causa de descarte) y con tope por objetivo, en orden de prioridad. Cuesta ≈5 créditos por página (un scrape normal ≈1).
# ENGINE_EXTRACT=off la apaga. ENGINE_EXTRACT_POLICY=all vuelve a la regla anterior (todas las que siguen; solo para medir).
ENGINE_EXTRACT=auto
ENGINE_EXTRACT_MAX=5
ENGINE_EXTRACT_POLICY=decisive
# 50 s por intento y SIN reintento tras timeout/5xx (ese intento pudo cobrarse). No se baja: en las corridas del 30/09 la mitad de las
# extracciones logradas tardó más de 64 s contando esperas; con menos tiempo serían timeouts igual de cobrados y sin resultado.
FIRECRAWL_EXTRACT_TIMEOUT_MS=50000
FIRECRAWL_EXTRACT_MAIN_ONLY=0
# Gasto de Firecrawl (todas las llamadas). Caché en disco por URL normalizada + tipo de llamada + versión del esquema/prompt; un acierto
# cuesta 0 créditos y lo cacheado se vuelve a verificar con el código contra la fecha de hoy. FIRECRAWL_CACHE_TTL_HOURS=0 la apaga.
# Por defecto vive en firecrawl-cache.sqlite junto a RESEARCH_DB (data/). La búsqueda principal del motor no se cachea.
FIRECRAWL_CACHE_TTL_HOURS=72
# FIRECRAWL_CACHE_DB=data/firecrawl-cache.sqlite
# Tope de créditos por día (UTC), compartido por el servidor y los scripts que usan la misma base. Sin definir = 100 (≈3 000/mes).
# Al llegar al tope se apagan la segunda lectura, el scrape de respaldo y las búsquedas no principales (la corrida sigue y queda en el
# Run audit). La búsqueda principal cuenta pero no se bloquea. "unlimited" quita el tope.
FIRECRAWL_DAILY_CREDITS=100
# Tope opcional por corrida (por objetivo del motor). Vacío = sin tope por corrida.
# FIRECRAWL_RUN_CREDITS=40
# Investigador (modo calidad, al estilo de Vane/Perplexity): tras la búsqueda inicial, un modelo FUERTE mira lo que salió, dice qué es
# genérico y decide qué buscar y qué páginas abrir (de una noticia que nombra programas pasa a la página oficial de cada uno). El modelo
# solo elige por número entre los resultados de los buscadores; todo lo que halla pasa por la misma lectura y verificación en código.
# 0 = apagado (por defecto). Con el modelo potente de la flota: ENGINE_RESEARCH_STEPS=3 y ENGINE_LLM_URL/ENGINE_LLM_MODEL (o
# ENGINE_RESEARCH_ROLE=reasoning). Cada paso es una llamada al modelo; las páginas que abre pueden gastar lectura de Firecrawl (tiene tope).
ENGINE_RESEARCH_STEPS=0
ENGINE_RESEARCH_SEARCHES=8
ENGINE_RESEARCH_OPENS=6
ENGINE_RESEARCH_PER_STEP=4
ENGINE_RESEARCH_MS=240000
# ENGINE_RESEARCH_ROLE=engine
ENGINE_READ_CONCURRENCY=4
LINKUP_DEPTH=standard
EXA_SEARCH_TYPE=auto
TAVILY_DEPTH=basic

# Modelo que PLANEA y LEE en el motor v2 (rol "engine"). Cualquier API compatible con OpenAI. Vacío = rol chat (Qwen3-30B).
# En g355 lo levanta scripts/g355-serve-engine-model.sh (por defecto openai/gpt-oss-120b en el puerto 8010).
ENGINE_LLM_URL=
ENGINE_LLM_MODEL=
ENGINE_LLM_API_KEY=
# 0 = no pedir response_format JSON (necesario para gpt-oss y para APIs que no lo soportan; el JSON se extrae del texto)
ENGINE_LLM_JSON_MODE=
# low|medium|high para modelos de razonamiento (gpt-oss)
ENGINE_LLM_REASONING_EFFORT=
ENGINE_LLM_MAX_TOKENS=
ENGINE_LLM_TIMEOUT_MS=240000

# ───────── V13 · Agente de compilación y agente juez (apagado por defecto) ─────────
# ENGINE_JUDGE=1 activa el flujo por página: compilador (recopila hechos con cita literal) → juez (valida criterio por criterio) →
# auditor en código (cita literal, resta contra hoy, estado open|closed|forecast|unknown). Sin los dos roles configurados, el
# comportamiento no cambia y el audit lo avisa. El juez caído o con JSON inválido deja la página en «a verificar»: nada entra a la lista principal.
# ENGINE_JUDGE_BLIND=1 oculta al juez la conclusión del compilador (independencia); 0 (por defecto) se la muestra como afirmaciones a verificar.
ENGINE_JUDGE=
ENGINE_JUDGE_BLIND=
# Valores finales: docs/handoff/V13-DESPLIEGUE.md (los confirma el despliegue). Sin claves en el repo.
COMPILER_LLM_URL=
COMPILER_LLM_MODEL=
COMPILER_LLM_API_KEY=
COMPILER_LLM_JSON_MODE=
COMPILER_LLM_TIMEOUT_MS=
# Respaldo explícito (vacío = ninguno): engine | chat. Con respaldo, compilador y juez pueden ser el mismo modelo; el audit lo marca.
COMPILER_LLM_FALLBACK=
JUDGE_LLM_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
# low|medium|high para gpt-oss; 0 en JSON_MODE si el servidor no admite response_format
JUDGE_LLM_REASONING_EFFORT=
JUDGE_LLM_JSON_MODE=
# Sin valor se usa VLLM_TIMEOUT_MS (120000). gpt-oss con razonamiento sobre una página larga puede tardar más: con timeout agotado el juez cuenta como caído (falla cerrado). Sugerido: 300000.
JUDGE_LLM_TIMEOUT_MS=
JUDGE_LLM_FALLBACK=

# ───────── V14 · Bucle agentic (apagado por defecto) ─────────
ENGINE_AGENT=0
ENGINE_AGENT_LLM_URL=
ENGINE_AGENT_LLM_MODEL=
ENGINE_AGENT_LLM_REASONING_EFFORT=medium
ENGINE_AGENT_LLM_JSON_MODE=1
ENGINE_AGENT_LLM_TIMEOUT_MS=240000
ENGINE_AGENT_LLM_FALLBACK=
ENGINE_AGENT_STEPS=40
ENGINE_AGENT_SEARCHES=20
ENGINE_AGENT_OPENS=30
ENGINE_AGENT_SECONDS=1200
ENGINE_AGENT_APOLLO_CREDITS=25
ENGINE_AGENT_JUDGE_SECOND=10

# ───────── Orquestador de búsqueda (30/09/2026) ─────────
# Tras la primera pasada: evalúa → reflexiona (OpenJev/Jev o reglas) → nueva estrategia → hasta N intentos más.
# 0 = apagado. Suficiente = al menos ORCHESTRATOR_MIN_TOP prioritarios y ORCHESTRATOR_MIN_EMAIL_RATE con email.
ORCHESTRATOR=
# El modelo GRANDE (rol 'engine', ENGINE_LLM_*) hace la parte inteligente: evalúa, diagnostica y ESCRIBE las búsquedas nuevas viendo lo que sirvió,
# lo que el código descartó y por qué, y lo que ya se probó. Reglas y OpenJev quedan de respaldo si el modelo falla. El código lo acota (no puede
# dar por suficiente lo que está por debajo de la mitad del objetivo; consultas validadas; todo pasa por la verificación del motor).
# auto (por defecto) = se enciende solo si ENGINE_LLM_URL y ENGINE_LLM_MODEL están puestos · 0 = apagado · 1 = forzar con el rol de ORCHESTRATOR_AI_ROLE.
# ORCHESTRATOR_AI=auto
# ORCHESTRATOR_AI_ROLE=engine
# ORCHESTRATOR_AI_QUERIES=8
ORCHESTRATOR_MAX_ATTEMPTS=2
ORCHESTRATOR_MIN_TOP=12
ORCHESTRATOR_MIN_EMAIL_RATE=0.35
# Tiempo máximo por intento y margen que se deja al final de la corrida para rankear y redactar.
ORCHESTRATOR_ATTEMPT_MS=120000
ORCHESTRATOR_RESERVE_MS=40000
# Tiempo total de una corrida (antes 180 s; con los intentos extra, 240 s).
# RESEARCH_RUN_TIMEOUT_MS=240000
# Pistas de buscador que solo traen snippet: se abre la página y se añade una cita literal (0 = no).
CONFIRM_SNIPPETS=
CONFIRM_SNIPPETS_MAX=15
CONFIRM_SNIPPETS_MS=40000

# ───────── Hunter.io: emails y personas por organización ─────────
# email-finder para personas sin email; domain-search para organizaciones sin persona.
HUNTER_API_KEY=
HUNTER_MAX_CALLS=30
HUNTER_MAX_DOMAINS=12
HUNTER_PEOPLE_PER_DOMAIN=3
# Confianza mínima (0-100) para aceptar un email.
HUNTER_MIN_SCORE=70

# ───────── Serper y Firecrawl en el buscador múltiple ─────────
# Serper entra solo si hay SERPER_API_KEY. Firecrawl lee páginas difíciles siempre que haya clave; como
# buscador solo si lo añades a ENGINE_SEARCH_PROVIDERS (gasta 1 crédito por página).
# SERPER_GL=us
# FIRECRAWL_SEARCH_MARKDOWN=1
# Reintentos ante 408/429/5xx y minutos que Firecrawl queda apagado tras un 401/402.
WEB_RETRIES=2
WEB_BREAKER_MS=900000

# ── Expansión desde lo verificado (enlaces, parecidos, rutas del sitio, ángulos laterales) ──
# Activa por defecto con el motor; ENGINE_EXPAND=off la apaga. Todo pasa por la misma verificación.
# ENGINE_EXPAND=off   (los reintentos del orquestador no la repiten)
# ENGINE_EXPAND_SEEDS=4          # páginas verificadas que sirven de mapa
# ENGINE_EXPAND_LINKS=6          # enlaces por semilla
# ENGINE_EXPAND_PAGES=12         # tope de páginas nuevas por objetivo
# ENGINE_EXPAND_DIVE=2           # semillas cuyo sitio se recorre (Common Crawl; 0 = no)
# ENGINE_EXPAND_SIMILAR_SEEDS=3  # semillas para Exa findSimilar (necesita EXA_API_KEY; ENGINE_EXPAND_SIMILAR=off lo apaga)
# ENGINE_EXPAND_QUERIES=10       # tope de consultas laterales
# ENGINE_EXPAND_OPENALEX=off     # financiadores de papers del tema (grants; gratis)
# ENGINE_EXPAND_EDGAR=off        # emisores de Form D recientes (inversión)
# ENGINE_EXPAND_AI=off           # ángulos laterales escritos por el modelo grande
# OPENALEX_MAILTO=tu@correo.org  # opcional: cortesía de OpenAlex
# SEC_USER_AGENT="Tu Organización contacto@tu-dominio.org"   # la SEC lo exige; sin él no se consulta EDGAR

# Fuentes de grants (inteligencia RePORTER/NSF, SBIR, portales por jurisdicción)
# GRANT_INTEL=off            # apaga RePORTER/NSF Awards como inteligencia
# REGISTRY_VERIFY_MAX=30     # convocatorias de registros que lee el motor
# ENGINE_PORTAL_SEEDS=6      # portales de la jurisdicción que se recorren
# ENGINE_PORTAL_LINKS=5      # enlaces por portal que pasan a lectura

# --- Producción (no documentadas hasta 07/10/2026) ---
# Activa el asesor automático salvo que valga 0 (research/server/analysis/advisorRoutes.mjs:167).
# ADVISOR_AUTO=
# Selecciona el modelo o adaptador LoRA del asesor (research/server/analysis/advisor.mjs:246).
# ADVISOR_MODEL=
# Selecciona el rol del asesor; por defecto, chat (research/server/analysis/advisor.mjs:244).
# ADVISOR_ROLE=
# Limita las relecturas para comprobar fechas; por defecto, 12 (research/server/research/engine.mjs:237).
# ENGINE_DATE_REREAD_MAX=
# Selecciona el rol que genera ángulos laterales; por defecto, engine (research/server/research/lateral.mjs:64).
# ENGINE_EXPAND_ROLE=
# Desactiva findSimilar de Exa cuando vale off (research/server/research/expansion.mjs:39).
# ENGINE_EXPAND_SIMILAR=
# Desactiva el modo de razonamiento de modelos Qwen cuando vale 0 (research/server/analysis/fleet.mjs:33).
# ENGINE_LLM_THINKING=
# Añade el año a las consultas cuando vale append (research/server/research/engine.mjs:82).
# ENGINE_QUERY_YEAR=
# Fija el número de candidatos del investigador; por defecto, 40 (research/server/research/researcher.mjs:43).
# ENGINE_RESEARCH_CANDIDATES=
# Define el filtro temporal para objetivos con fecha; por defecto, qdr:y (research/server/research/engine.mjs:231).
# ENGINE_TBS=
# Limita las trazas conservadas; por defecto, 250 (research/server/research/engine.mjs:236).
# ENGINE_TRACE_MAX=
# Limita las trazas de descartes conservadas; por defecto, 80 (research/server/research/engine.mjs:269).
# ENGINE_TRACE_SKIPPED_MAX=
# Limita los caracteres de texto pedidos a Exa; por defecto, 20000 (research/server/research/searchApis.mjs:82).
# EXA_TEXT_CHARS=
# Desactiva el caché de Firecrawl cuando vale off (research/server/research/firecrawlLedger.mjs:57).
# FIRECRAWL_CACHE=
# Fija la espera tras límites de Firecrawl; por defecto, 6000 ms (research/server/research/webscrape.mjs:71).
# FIRECRAWL_RATE_BACKOFF_MS=
# Fija el timeout de scrape de Firecrawl; por defecto, 25000 ms (research/server/research/webscrape.mjs:197).
# FIRECRAWL_SCRAPE_TIMEOUT_MS=
# Fija el timeout de búsqueda de Firecrawl; por defecto, 85000 o 30000 ms (research/server/research/webscrape.mjs:196).
# FIRECRAWL_SEARCH_TIMEOUT_MS=
# Limita las consultas API de grants; por defecto, 6 (research/server/research/pipeline.mjs:158).
# GRANT_API_QUERIES=
# Desactiva la lectura de convocatorias con modelo cuando vale 0 (research/server/research/pipeline.mjs:367).
# GRANT_PAGE_MODEL=
# Limita los créditos de búsqueda web de grants; por defecto, 200 (research/server/research/webscrape.mjs:357).
# GRANT_WEB_CREDITS=
# Desactiva las consultas de grants generadas por modelo cuando vale 0 (research/server/research/webscrape.mjs:355).
# GRANT_WEB_MODEL_QUERIES=
# Fija el timeout de Hunter; por defecto, 20000 ms (research/server/research/hunter.mjs:64).
# HUNTER_TIMEOUT_MS=
# Limita la respuesta; respaldo de modelo: INTAKE_LLM_* → chat → engine (research/server/analysis/fleet.mjs:28).
# INTAKE_LLM_MAX_TOKENS=
# Configura el razonamiento; respaldo de modelo: INTAKE_LLM_* → chat → engine (research/server/analysis/fleet.mjs:28).
# INTAKE_LLM_REASONING_EFFORT=
# Controla el rol; respaldo de modelo: INTAKE_LLM_* → chat → engine (research/server/research/intake.mjs:336).
# INTAKE_LLM_ROLE=
# Omite contenido en resultados Jina cuando vale 0 (research/server/research/searchApis.mjs:110).
# JINA_SEARCH_CONTENT=
# Fija el timeout de Jina; por defecto, 60000 ms (research/server/research/searchApis.mjs:110).
# JINA_TIMEOUT_MS=
# Fija el timeout de Linkup; por defecto, 60000 ms (research/server/research/searchApis.mjs:69).
# LINKUP_TIMEOUT_MS=
# Fija el timeout de reflexión con Jev; por defecto, 25000 ms (research/server/research/orchestrator.mjs:188).
# ORCHESTRATOR_JEV_TIMEOUT_MS=
# Reserva tiempo restante para cerrar la corrida; por defecto, 45000 ms (research/server/research/orchestrator.mjs:359).
# ORCHESTRATOR_MIN_REMAINING_MS=
# Ordena los lectores de páginas y sus respaldos (research/server/research/pipeline.mjs:357).
# PAGE_READER_ORDER=
# Indica el ejecutable de Chromium que usa Playwright (research/server/research/browser.mjs:63).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Limita las expansiones de consulta con Exa; por defecto, 4 (research/server/research/providers.mjs:887).
# QUERY_EXPAND_EXA_MAX=
# Desactiva la expansión de consultas con LLM cuando vale 0 (research/server/research/expand.mjs:54).
# QUERY_EXPAND_LLM=
# Limita los términos expandidos, incluido el original; por defecto, 4 (research/server/research/expand.mjs:81).
# QUERY_EXPAND_MAX=
# Fija el timeout de expansión con LLM; por defecto, 15000 ms (research/server/research/expand.mjs:65).
# QUERY_EXPAND_TIMEOUT_MS=
# Desactiva la verificación de registros cuando vale off (research/server/research/registryVerify.mjs:46).
# REGISTRY_VERIFY=
# Desactiva el navegador cuando vale off (research/server/index.mjs:30).
# RESEARCH_BROWSER=
# Fija la calidad JPEG de capturas; por defecto, 60 (research/server/research/browser.mjs:39).
# RESEARCH_BROWSER_JPEG_QUALITY=
# Fija el timeout de navegación; por defecto, 15000 ms (research/server/research/browser.mjs:38).
# RESEARCH_BROWSER_TIMEOUT_MS=
# Añade orígenes públicos CORS separados por comas (research/server/index.mjs:96).
# RESEARCH_PUBLIC_ORIGIN=
# Alias de ScrapeGraph: SCRAPEGRAPH_API_KEY ≡ SGAI_API_KEY (research/server/research/webscrape.mjs:23).
# SCRAPEGRAPH_API_KEY=
# Selecciona complementos del buscador base; por defecto, exa,serper (research/server/research/searchApis.mjs:26).
# SEARCH_COMPLEMENT=
# Selecciona SearXNG como buscador base cuando vale searxng (research/server/research/searchApis.mjs:19).
# SEARCH_PROVIDER=
# Fija el timeout de SearXNG; por defecto, 25000 ms (research/server/research/localSearch.mjs:18).
# SEARXNG_TIMEOUT_MS=
# Fija el timeout de Serper; por defecto, 20000 ms (research/server/research/searchApis.mjs:119).
# SERPER_TIMEOUT_MS=
# Alias de Jev: TYPESAFE_API_KEY ≡ JEV_API_KEY (research/server/index.mjs:178).
# TYPESAFE_API_KEY=
# Limita las páginas de LinkedIn; por defecto, 6 (research/server/research/webscrape.mjs:691).
# WEB_LINKEDIN_MAX_PAGES=
# Fija el timeout de peticiones web; por defecto, 90000 ms (research/server/research/webscrape.mjs:89).
# WEB_TIMEOUT_MS=
# Sustituye la URL de búsqueda de You.com (research/server/research/searchApis.mjs:92).
# YOU_API_URL=

# --- Benchmark: preanotador (nombres que fija run_config.preannotator_model) ---
# URL base que run_config.preannotator_model entrega al rol engine (research/bench/cli.mjs:210).
# PREANNOTATOR_BASE_URL=
# Modelo que run_config.preannotator_model entrega al rol engine (research/bench/cli.mjs:211).
# PREANNOTATOR_MODEL=
# Clave que run_config.preannotator_model entrega al rol engine (research/bench/cli.mjs:212).
# PREANNOTATOR_API_KEY=

# Simpler.Grants.gov (registro federal de EE. UU.): búsqueda con relevancia y avisos completos. Clave en https://simpler.grants.gov/developer (cuenta Login.gov).
# Sin clave se usa la API pública de Grants.gov (sin avisos completos).
SIMPLER_GRANTS_API_KEY=
