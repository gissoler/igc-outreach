+/* Palabras que aparecen en casi cualquier convocatoria de salud o tecnología: solas no prueban encaje temático. */
+export const GENERIC_TOPIC_WORDS = new Set(['health', 'healthcare', 'digital', 'care', 'data', 'tool', 'tools', 'self', 'well', 'being', 'monitoring', 'tracking', 'program', 'programs', 'support', 'services', 'service', 'system', 'systems', 'solution', 'solutions', 'innovation', 'innovative', 'technology', 'technologies', 'research', 'based', 'platform', 'management', 'public', 'community', 'people', 'development']);
+const TOPIC_STOPWORDS = new Set(['and', 'the', 'for', 'with', 'from', 'into', 'that', 'this', 'your', 'our']);
+/**
+ * Encaje temático por palabras completas: palabras específicas (peso 1) y bigramas de cada término
+ * ("mental health" 1; "digital health", dos genéricas, 0.5). "health" o "tools" solos ya no suman,
+ * y "mental" no coincide dentro de "environmental".
+ */
+export function topicMatcher(sources = []) {
+  const units = new Map();
+  for (const { label, value } of sources) {
+    const words = norm(value).split(' ').filter((w) => w.length > 2 && !TOPIC_STOPWORDS.has(w));
+    words.forEach((word, i) => {
+      if (!GENERIC_TOPIC_WORDS.has(word) && !units.has(word)) units.set(word, { weight: 1, label });
+      const next = words[i + 1];
+      if (next && !units.has(`${word} ${next}`)) units.set(`${word} ${next}`, { weight: GENERIC_TOPIC_WORDS.has(word) && GENERIC_TOPIC_WORDS.has(next) ? 0.5 : 1, label });
+    });
+  }
+  const total = [...units.values()].reduce((n, u) => n + u.weight, 0);
+  return (text) => {
+    const hay = ` ${norm(text)} `;
+    const found = [...units].filter(([unit]) => hay.includes(` ${unit} `));
+    const got = found.reduce((n, [, u]) => n + u.weight, 0);
+    return { fit: Math.min(1, got / Math.max(2, Math.min(6, total))), hits: found.map(([unit]) => unit), labels: [...new Set(found.map(([, u]) => u.label))] };
+  };
+}
