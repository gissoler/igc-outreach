+// Calidad de búsqueda de grants (revisión 29/09/2026, brief Mentiva). Cada caso viene de un fallo visto en el run 8f544426.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { AGGREGATOR_HOSTS, grantWebOpportunities, opportunityDate } from '../server/research/webscrape.mjs';
+import { candidate, evaluate, evidence, topicMatcher } from '../server/research/core.mjs';
+import { evaluateRule, IGC_PROFILE, profileForBrief } from '../server/analysis/eligibility.mjs';
+
+const NOW = new Date('2026-09-29T12:00:00Z');
+
+test('deadline parser reads the formats real program pages use', () => {
+  const cases = {
+    'Deadline: 30 June 2026': '2026-06-30', // Brain Innovation Days: antes null → "open"
+    '**Apply by** April 5, 2023': '2023-04-05', // markdown en negrita
+    'Application deadline: November 2, 2026': '2026-11-02',
+    'Solution Deadline November 2, 2026 12:00pm EST': '2026-11-02', // MIT Solve
+    'Reviewed on a Rolling Basis Through October 19, 2026': '2026-10-19', // One Mind Accelerator
+    'Deadline: 2026-11-02': '2026-11-02',
+    'with an application deadline of 18 September 2026.': '2026-09-18', // wellcome.org (el agregador decía 2 Oct)
+    'Deadline: Monday, February 2, 2027 at noon': '2027-02-02',
+    'Fall 2026: deadline July 31, 2026. Spring 2027: deadline January 15, 2027': '2027-01-15', // próximo ciclo
+    'The application period is open now through April 5.': null, // sin año: no se inventa
+    'Deadline: February 30, 2026': null, // fecha imposible
+  };
+  for (const [text, expected] of Object.entries(cases)) assert.equal(opportunityDate(text, NOW), expected, text);
+});
+
+function mockFetch(web) {
+  const calls = [];
+  const fetcher = async (url, init) => { calls.push(JSON.parse(init.body)); return { ok: true, status: 200, text: async () => JSON.stringify({ data: { web } }) }; };
+  return { fetcher, calls };
+}
+
+test('open-web grants: aggregators are skipped, undated pages are not "open", search is limited to the past year', async () => {
+  const pad = (s) => s.padEnd(300, ' ');
+  const { fetcher, calls } = mockFetch([
+    { url: 'https://www.startupgrantsindia.com/wellcome-prize-mental-health-science-nature', title: 'The Wellcome Prize for Mental Health Science', markdown: pad('Apply now. Deadline: 2 October 2026. Sign up to read this grant.') },
+    { url: 'https://www.headstreaminnovation.com/post/2026-members', title: 'Headstream Announces the 2026 Members of its Accelerator', markdown: pad('Headstream accelerator cohort for youth mental health startups. Founders will sharpen their business models.') },
+    { url: 'https://www.braininnovationdays.eu/2026-bids-pitch-competition/', title: 'BIDs Pitch Competition', markdown: pad('Brain Innovation Days Pitch Competition for start-ups. **Deadline:** 30 June 2026. Apply here.') },
+  ]);
+  const results = await grantWebOpportunities({ industry: 'mental health', product: 'well-being navigation', stage: 'prototype' }, { terms: [{ term: 'mental health' }] }, { env: { FIRECRAWL_API_KEY: 'fc', GRANT_WEB_MAX_SEARCHES: '1' }, fetcher });
+  assert.ok(AGGREGATOR_HOSTS.test('www2.fundsforngos.org'));
+  assert.equal(results.some((r) => /startupgrantsindia/.test(r.org)), false, 'aggregator is not an official program page');
+  assert.equal(results.searchAudit[0].aggregatorsSkipped, 1);
+  assert.equal(results.find((r) => /headstream/.test(r.org)).status, 'unknown');
+  const bids = results.find((r) => /braininnovationdays/.test(r.org));
+  assert.equal(bids.deadline, '2026-06-30');
+  assert.equal(calls[0].tbs, 'qdr:y');
+});
+
+const brief = { industry: 'wellness mental health digital health', exclusions: '', fundingTypes: ['grant'], minDays: 30, mode: 'strategic', geography: 'GLOBAL', stage: 'prototype', criteria: '', constraints: '', amount: null };
+const terms = ['mental well-being tracking', 'emotional health monitoring', 'self-awareness tools'].map((term) => ({ term }));
+const call = (title, text, extra = {}) => candidate({ kind: 'opportunity', fundingType: 'grant', status: 'open', deadline: '2026-12-01', org: 'Agency', title, externalId: title, evidence: [evidence('Grants.gov', 'https://www.grants.gov/x', text, 'scope')], searchText: text, ...extra });
+
+test('topic fit ignores generic words: "health", "monitoring" or "tools" alone do not make a mental-health match', () => {
+  const ranked = evaluate([
+    call('Expanding global health security through local partnerships in Indonesia', 'Strengthen public health laboratory capacity, disease surveillance and monitoring tools.'),
+    call('Holistic and Evidence-Informed Wellness for STI Prevention', 'Community programs for sexually transmitted infection prevention and health monitoring.'),
+    call('Environmental health tracking', 'Environmental exposure data for public health.'),
+    call('Digital mental health interventions', 'Test digital mental health platforms that improve emotional well-being and mental health outcomes.'),
+  ], brief, new Set(), NOW, terms);
+  const by = Object.fromEntries(ranked.map((l) => [l.title.split(' ')[0], l]));
+  assert.equal(ranked[0].title, 'Digital mental health interventions');
+  assert.equal(by.Expanding.fit, 0);
+  assert.equal(by.Environmental.fit, 0, '"mental" must not match inside "environmental"');
+  assert.equal(by.Expanding.bucket, 'discarded');
+  assert.match(by.Expanding.discard, /Off-topic/);
+  // Antes: STI 0.67 de fit (74 pts) frente a 1.0 (86). Ahora el encaje real duplica al de STI.
+  assert.ok(ranked[0].fit >= 2 * by.Holistic.fit, `fit ${ranked[0].fit} vs ${by.Holistic.fit}`);
+  assert.ok(by.Holistic.fit <= 0.3);
+  const m = topicMatcher([{ label: 'x', value: 'mental health' }]);
+  assert.deepEqual(m('Environmental health').hits, []);
+});
+
+test('grant calls without a real close date go to the radar, not to priority', () => {
+  const [placeholder, undated, dated] = ['Program to End Modern Slavery', 'Innovations in Mental Health Fund', 'Mental health challenge'].map((t) => t);
+  const ranked = evaluate([
+    call(placeholder, 'mental health program', { deadline: '2099-01-01' }),
+    call(undated, 'mental health programme', { deadline: null, status: 'unknown' }),
+    call(dated, 'mental health challenge', { deadline: '2026-11-02' }),
+  ], brief, new Set(), NOW, terms);
+  const get = (t) => ranked.find((l) => l.title === t);
+  assert.equal(get(placeholder).bucket, 'radar');
+  assert.equal(get(placeholder).daysToDeadline, null);
+  assert.ok(get(placeholder).missing.includes('Close date is a placeholder, not a published deadline'));
+  assert.equal(get(undated).bucket, 'radar');
+  assert.ok(get(undated).missing.includes('Application deadline not confirmed'));
+  assert.equal(get(dated).bucket, 'top');
+});
+
+test('eligibility: a non-IGC venture is not evaluated with the IGC profile', () => {
+  const mentiva = profileForBrief({ company: 'Mentiva', venture: 'Mentiva', organization: 'Mentiva' });
+  assert.equal(mentiva.name, 'Mentiva');
+  assert.equal(mentiva.usEntity.value, null);
+  assert.equal(mentiva.publiclyTraded.value, null);
+  assert.equal(profileForBrief({ company: 'IGC Pharma' }), IGC_PROFILE);
+});
+
+test('eligibility: a loose applicant-type sentence cannot exclude a for-profit; the official list can', () => {
+  const profile = { entityType: { value: 'for_profit' } };
+  // Regla real de la flota para PAR-25-136, cuya lista oficial sí admite for-profit y small business.
+  assert.equal(evaluateRule({ type: 'entity_type', requirement: 'required', quote: 'U.S. Territory or Possession', method: 'flota' }, profile).verdict, '?');
+  assert.equal(evaluateRule({ type: 'entity_type', requirement: ['State governments', 'Nonprofits'], quote: 'Eligible applicant types', method: 'official field' }, profile).verdict, '✖');
+});
