{
  "name": "igc-public-research",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval:search": "node scripts/eval-search.mjs",
    "preflight:apollo": "node --env-file-if-exists=.env scripts/apollo-preflight.mjs",
    "browser:install": "playwright install chromium",
    "test:agent": "node --test tests/agent/*.test.mjs",
    "test:investors": "node --test tests/agent/investors.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0"
  }
}
